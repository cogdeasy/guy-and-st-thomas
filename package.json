{
  "name": "trustos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrustOS — Digital Hospital Platform for Guy's and St Thomas' NHS Foundation Trust",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @trustos/api build && pnpm --filter @trustos/web build",
    "dev": "pnpm -r --parallel --filter @trustos/api --filter @trustos/web dev",
    "dev:api": "pnpm --filter @trustos/api dev",
    "dev:web": "pnpm --filter @trustos/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/**\" --filter @trustos/api test",
    "test:unit": "pnpm -r --filter \"./packages/**\" --filter @trustos/api test",
    "test:e2e": "pnpm --filter @trustos/e2e test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
